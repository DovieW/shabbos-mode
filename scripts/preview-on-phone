#!/usr/bin/env bash
set -euo pipefail

preview_host="${PREVIEW_HOST:-dovie@dovie-ideapad-linux}"
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export JAVA_HOME="${JAVA_HOME:-$HOME/.local/share/shabbos-mode/jdk17}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"

cd "$repo_dir"
./gradlew :app:assembleDebug

ssh "$preview_host" 'mkdir -p "$HOME/.cache/shabbos-mode"'
scp app/build/outputs/apk/debug/app-debug.apk "$preview_host:.cache/shabbos-mode/app-debug.apk"
ssh "$preview_host" 'bash -s' <<'REMOTE'
set -euo pipefail
device_count="$(adb devices | awk 'NR > 1 && $2 == "device" { count++ } END { print count + 0 }')"
if [[ "$device_count" != 1 ]]; then
    printf 'Expected one authorized Android device on the preview host; found %s.\n' "$device_count" >&2
    exit 1
fi
adb install -r "$HOME/.cache/shabbos-mode/app-debug.apk"
adb shell am start -n dev.dovie.shabbosmode/.MainActivity
REMOTE

#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
device="${SHABBOS_ANDROID_DEVICE:-galaxy-s25u.barn-chameleon.ts.net:5555}"

export JAVA_HOME="${JAVA_HOME:-$HOME/.local/share/shabbos-mode/jdk17}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"

cd "$repo_dir"
./gradlew :app:assembleDebug

# ADB drops idle network transports. Reconnect before every deployment.
if ! timeout 15 adb connect "$device"; then
    printf 'Could not reach %s. Check that the phone is online in Tailscale and ADB TCP mode is enabled.\n' "$device" >&2
    exit 1
fi
if ! timeout 15 adb -s "$device" wait-for-device; then
    printf 'ADB did not authorize %s.\n' "$device" >&2
    exit 1
fi

adb -s "$device" install -r app/build/outputs/apk/debug/app-debug.apk
adb -s "$device" shell am start -n dev.dovie.shabbosmode/.MainActivity
printf 'To read device logs: adb -s %s logcat\n' "$device"
